# Trợ lý ảo hỗ trợ sinh viên — biến môi trường.
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.

# Chung
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# PostgreSQL — chạy qua Docker (host port 5433, container vẫn 5432)
POSTGRES_USER=student_assistant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=student_assistant
POSTGRES_PORT=5433
DATABASE_URL=postgresql://student_assistant:change_me_in_production@localhost:5433/student_assistant?schema=public

# ChromaDB — container Docker, cổng map ra 8001 (tránh trùng rag-service)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=sa

# NestJS API
API_PORT=5000
# Số tiến trình API (≈ số lõi CPU trừ 1–2) và kích thước bể kết nối CSDL mỗi tiến trình
API_WORKERS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
API_PREFIX=api
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1
MAX_UPLOAD_BYTES=26214400
STORAGE_ROOT=./server/storage
# Đăng nhập: mỗi email 5 lần/phút; mỗi IP 600 lần/phút (cả trường có thể chung một IP)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_LOGIN_IP_PER_MIN=600
RATE_LIMIT_CHAT_PER_MIN=12

# LLM (reader) — chỉ dùng Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=60
GEMINI_MAX_RETRIES=2
LLM_BATCH_CONCURRENCY=2

# Mô hình embedding / rerank (CPU, ~4.5 GB RAM)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=./.cache/huggingface
PRELOAD_MODELS=1
QUANTIZE_RERANKER=1

# Tham số pipeline RAG (đối chiếu notebook gốc — xem docs/rag/pipeline.md)
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
MIN_CHUNK_CHARS=25
CANDIDATES_K=16
FINAL_K=5
MAX_RETRIEVAL_ROUNDS=2
MAX_SUBQUERIES=3
USE_LLM_CONTEXT=1
MAX_CONTEXT_CHUNKS=900
# Phải CALIBRATE bằng scripts/calibrate_tau.py, không đoán bằng tay.
ANSWER_THRESHOLD=0.050

# Web (Vite)
WEB_PORT=5173
VITE_API_URL=http://localhost:5000/api
